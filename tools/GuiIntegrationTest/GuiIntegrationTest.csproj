<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 用 Exe 而不是 WinExe：测试工具需要把结果打印到控制台 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GuiIntegrationTest</RootNamespace>
    <AssemblyName>GuiIntegrationTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TransferCore\TransferCore.csproj" />
    <ProjectReference Include="..\..\src\FileTransferServer\FileTransferServer.csproj" />
    <ProjectReference Include="..\..\src\FileTransferClient\FileTransferClient.csproj" />
  </ItemGroup>

</Project>
